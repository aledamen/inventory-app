# --- Base de datos (Neon Postgres) ---
# Connection string del pooler. Dashboard de Neon (neon.tech) > tu proyecto > Connect,
# o Vercel > Storage, si la DB está linkeada como integración del proyecto.
DATABASE_URL=

# --- Autenticación (Clerk) ---
# Dashboard de Clerk (dashboard.clerk.com) > tu app > API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Rutas de la app, no son secretos — dejar tal cual salvo que cambien las rutas de sign-in/sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Almacenamiento de imágenes (Vercel Blob) ---
# Vercel > Storage > tu Blob store > tab ".env.local".
BLOB_READ_WRITE_TOKEN=

# --- Integración con catalogo-app ---
# URL donde corre catalogo-app (el frontend público). Se usa para pegarle al endpoint
# /api/revalidate de catalogo-app cuando cambian productos/precios/config acá.
CATALOG_APP_URL=

# Secreto compartido con catalogo-app para autenticar ese POST a /api/revalidate
# (header x-revalidate-secret). Inventalo vos (string random) y poné el MISMO valor
# en el REVALIDATE_SECRET de catalogo-app — si no coinciden, la revalidación falla en silencio.
REVALIDATE_SECRET=

# --- Solo para scripts puntuales de mantenimiento (no se usan en `dev`/`build`) ---
# scripts/migrate.ts (npm run db:migrate:excel) — path al Excel a importar
# EXCEL_PATH=
# scripts/fix-sale-totals.ts — si está seteado, corre en modo simulación sin escribir en la DB
# DRY_RUN=
